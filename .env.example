# Loop Local — Supabase environment template
# Copy to .env.local or app-specific env file. Do not commit real values.

SUPABASE_PROJECT_REF=itraeknotcdtdzaeukan
NEXT_PUBLIC_SUPABASE_URL=https://itraeknotcdtdzaeukan.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Durable repository cutover: keep `file` until migration/reconciliation is approved.
LOCAL_SUBMISSIONS_ADAPTER=file
# Optional file adapter override; defaults to runtime-data/local-submissions.json.
LOCAL_SUBMISSIONS_FILE=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional deployment/health metadata
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_SITE_URL=
LOOP_LOCAL_PUBLIC_URL=
LOOP_LOCAL_DEPLOYMENT_TARGET=local
LOOP_LOCAL_GIT_SHA=

# Optional operator configuration (server-only unless explicitly documented otherwise)
LOOP_LOCAL_OPERATOR_EMAILS=

# Optional monitoring configuration. Keep webhook values out of source control.
LOOP_LOCAL_HEALTH_URL=
LOOP_LOCAL_ALERT_WEBHOOK_URL=
